EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=optional-google-maps-embed-key
# Use localhost for web/emulator on this computer. For a physical phone, use
# this computer's LAN IP, e.g. http://192.168.1.10:3000.
EXPO_PUBLIC_BACKEND_URL=
# Groq is read only by the Express backend, never by the Expo client.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
ORANGE_MONEY_API_KEY=TEST_MODE
NEXT_PUBLIC_APP_URL=http://localhost:3000
